#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4
#define AUTO_MOUSE 5
#define SCROLL 1

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

// トラックボールの設定(AML, SCROLL)

&trackball_listener {
    input-processors = <
                        // トラックボールの向きの変更(ZaruBallv1とv2,v3ではセンサーの向きが異なるので調整してください。デフォルトではv2,v3用)
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer AUTO_MOUSE 500 // 500ms stay at auto mouse layer
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            // スクロールの向きの変更
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20 // スクロールの感度(default: x20)
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG2>, <&mo RAISE>, <&mo 5>;
        };

        scroll_mouse: behavior_scroll_mouse {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
        };

        lt_exit_AML: behavior_lt_exit_AML {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo_exit_AML>, <&to_layer_0>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to BASE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to BASE>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "KP_EXIT_AML";
        };

        mo_exit_AML: mo_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to BASE>,
                <&macro_press>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER>;

            label = "MO_EXIT_AML";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer)

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl AUTO_MOUSE>;

            label = "MKP_EXIT_AML";
        };

        // Support swapping into Scroll layer when AML is activated

        to_scroll_layer: to_scroll_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to SCROLL>,
                <&macro_press>,
                <&mo SCROLL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo SCROLL>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC       &kp N1  &kp N2      &kp N3    &kp N4         &kp N5                            &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                 &kp NUMBER_6  &kp N7            &kp N8  &kp N9     &kp N0   &kp BACKSPACE
&kp TAB       &kp Q   &kp W       &kp E     &kp R          &kp T                             &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY               &kp Y         &kp U             &kp I   &kp O      &kp P    &kp MINUS
&kp LEFT_ALT  &kp A   &kp S       &kp D     &kp F          &kp G               &kp EQUAL     &kp KP_N1     &kp KP_N2  &kp KP_N3       &kp KP_MINUS    &kp LBKT   &kp H             &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHFT     &kp Z   &kp X       &kp C     &kp V          &kp B               &kp GRAVE     &kp KP_N0     &kp KP_DOT &kp KP_NUMLOCK  &kp KP_PLUS     &kp RBKT   &kp N             &kp M   &kp COMMA  &kp DOT  &kp SINGLE_QUOTE  &lt 3 FSLH
&kp LCTRL             &kp C_MUTE  &kp LWIN  &kp DEL        &lt 1 LANG2         &kp SPACE                                                            &mt RSHFT SPACE  &lt 1 LANG1                                            &scroll_mouse SCROLL MOUSE
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &kp F1   &kp F2     &kp F3    &kp F4     &kp F5                   &trans  &trans  &trans  &trans              &kp F6    &kp F7        &kp F8    &kp F9          &kp F10          &kp F11
&trans  &kp F6   &kp F7     &kp F8    &kp F9     &kp F10                  &trans  &trans  &trans  &trans              &kp F1    &kp F2        &kp F3    &kp F4          &kp F5           &kp F12
&trans  &kp F11  &kp HOME   &kp UP    &kp END    &kp HOME  &kp BACKSLASH   &trans  &trans  &trans  &trans    &kp LPAR  &kp C_VOL_UP    &kp HOME  &kp UP_ARROW    &kp END          &kp KP_MINUS  &trans
&trans  &none    &kp LEFT   &kp DOWN  &kp RIGHT  &kp END   &kp PIPE        &trans  &trans  &trans  &trans    &kp RPAR  &kp C_VOL_DN    &kp LEFT  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_PLUS   &trans
&trans           &kp RSHFT  &trans    &trans     &trans    &trans                                         &trans    &trans                                                   &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LA(F2) LA(F1)>;
            bindings = <
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none  &none
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none  &none
&trans  &none  &none  &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp PG_UP  &kp HOME  &none     &kp UP    &none      &none  &none
&trans  &none  &none  &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN  &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&trans  &none         &trans     &trans     &trans          &trans                                               &trans     &kp DEL                                         &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none         &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none         &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans                &kp C_MUTE    &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp_exit_AML ESC  &kp_exit_AML N1  &kp_exit_AML N2  &kp_exit_AML N3  &kp_exit_AML N4  &kp_exit_AML N5                  &kp_exit_AML KP_N7     &kp_exit_AML KP_N8  &kp_exit_AML KP_N9   &kp_exit_AML KP_DIVIDE                  &kp_exit_AML NUMBER_6  &kp_exit_AML N7     &kp_exit_AML N8  &kp_exit_AML N9  &kp_exit_AML N0  &kp_exit_AML BACKSPACE
&kp_exit_AML TAB  &kp_exit_AML Q   &kp_exit_AML W   &kp_exit_AML E   &kp_exit_AML R   &kp_exit_AML T                   &kp_exit_AML KP_N4     &kp_exit_AML KP_N5  &kp_exit_AML KP_N6   &kp_exit_AML KP_MULTIPLY                &kp_exit_AML Y         &kp_exit_AML U      &kp_exit_AML I   &kp_exit_AML O   &kp_exit_AML P   &kp_exit_AML MINUS
&trans           &kp_exit_AML A   &kp_exit_AML S   &kp_exit_AML D   &kp_exit_AML F   &msc SCRL_UP    &msc SCRL_LEFT   &kp_exit_AML KP_N1     &kp_exit_AML KP_N2  &kp_exit_AML KP_N3       &kp_exit_AML KP_MINUS    &kp_exit_AML LBKT   &kp_exit_AML H      &mkp LCLK       &mkp MCLK       &mkp RCLK       &kp_exit_AML SEMI  &kp_exit_AML ENTER
&trans           &kp_exit_AML Z   &kp_exit_AML X   &kp_exit_AML C   &kp_exit_AML V   &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp_exit_AML KP_N0     &kp_exit_AML KP_DOT &to_layer_0 KP_NUMLOCK  &kp_exit_AML KP_PLUS     &kp_exit_AML RBKT   &kp_exit_AML N      &mkp MB4        &mkp MB5        &kp_exit_AML DOT  &kp_exit_AML SINGLE_QUOTE  &kp_exit_AML FSLH
&trans                   &to_layer_0 C_MUTE   &kp_exit_AML LWIN  &trans  &lt_exit_AML LOWER LANG2  &kp_exit_AML SPACE                                  &kp_exit_AML SPACE  &lt_exit_AML LOWER LANG1                                  &scroll_mouse SCROLL MOUSE
            >;
        };

        auto_mouse_layer {
            display-name = "Auto Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp_exit_AML ESC  &kp_exit_AML N1  &kp_exit_AML N2  &kp_exit_AML N3  &kp_exit_AML N4  &kp_exit_AML N5                  &kp_exit_AML KP_N7     &kp_exit_AML KP_N8  &kp_exit_AML KP_N9   &kp_exit_AML KP_DIVIDE                  &kp_exit_AML NUMBER_6  &kp_exit_AML N7     &kp_exit_AML N8  &kp_exit_AML N9  &kp_exit_AML N0  &kp_exit_AML BACKSPACE
&kp_exit_AML TAB  &kp_exit_AML Q   &kp_exit_AML W   &kp_exit_AML E   &kp_exit_AML R   &kp_exit_AML T                   &kp_exit_AML KP_N4     &kp_exit_AML KP_N5  &kp_exit_AML KP_N6   &kp_exit_AML KP_MULTIPLY                &kp_exit_AML Y         &kp_exit_AML U      &kp_exit_AML I   &kp_exit_AML O   &kp_exit_AML P   &kp_exit_AML MINUS
&trans           &kp_exit_AML A   &kp_exit_AML S   &kp_exit_AML D   &kp_exit_AML F   &msc SCRL_UP    &msc SCRL_LEFT   &kp_exit_AML KP_N1     &kp_exit_AML KP_N2  &kp_exit_AML KP_N3       &kp_exit_AML KP_MINUS    &kp_exit_AML LBKT   &kp_exit_AML H      &mkp LCLK       &mkp MCLK       &mkp RCLK       &kp_exit_AML SEMI  &kp_exit_AML ENTER
&trans           &kp_exit_AML Z   &kp_exit_AML X   &kp_exit_AML C   &kp_exit_AML V   &msc SCRL_DOWN  &msc SCRL_RIGHT  &kp_exit_AML KP_N0     &kp_exit_AML KP_DOT &to_layer_0 KP_NUMLOCK  &kp_exit_AML KP_PLUS     &kp_exit_AML RBKT   &kp_exit_AML N      &mkp MB4        &mkp MB5        &kp_exit_AML DOT  &kp_exit_AML SINGLE_QUOTE  &kp_exit_AML FSLH
&trans                   &to_layer_0 C_MUTE   &kp_exit_AML LWIN  &trans  &lt_exit_AML LOWER LANG2  &kp_exit_AML SPACE                                  &kp_exit_AML SPACE  &lt_exit_AML LOWER LANG1                                  &scroll_mouse SCROLL MOUSE
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
