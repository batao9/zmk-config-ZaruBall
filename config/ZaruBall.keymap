#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3
#define MOUSE 4
#define SCROLL 1

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&zip_temp_layer {
    require-prior-idle-ms = <200>;
};

// トラックボールの設定(AML, SCROLL)

&trackball_listener {
    input-processors = <
                        // トラックボールの向きの変更(ZaruBallv1とv2,v3ではセンサーの向きが異なるので調整してください。デフォルトではv2,v3用)
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500 // 500ms stay at mouse layer
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            // スクロールの向きの変更
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20 // スクロールの感度(default: x20)
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        scroll_down_up_keep_mouse: sensor_rotate_keep_mouse {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&scroll_down_keep_mouse>, <&scroll_up_keep_mouse>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG2>, <&mo RAISE>, <&mo 5>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // Keep Mouse layer active when scrolling with the rotary encoder in Mouse layer

        scroll_down_keep_mouse: scroll_down_keep_mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&sl MOUSE>;
            label = "SCROLL_DOWN_KEEP_MOUSE";
        };

        scroll_up_keep_mouse: scroll_up_keep_mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&sl MOUSE>;
            label = "SCROLL_UP_KEEP_MOUSE";
        };

        scroll_left_keep_mouse: scroll_left_keep_mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&sl MOUSE>;
            label = "SCROLL_LEFT_KEEP_MOUSE";
        };

        scroll_right_keep_mouse: scroll_right_keep_mouse {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&sl MOUSE>;
            label = "SCROLL_RIGHT_KEEP_MOUSE";
        };

        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to BASE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer)

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        // Support swapping into Scroll layer when AML is activated

        to_scroll_layer: to_scroll_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to SCROLL>,
                <&macro_press>,
                <&mo SCROLL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo SCROLL>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&kp ESC       &kp N1  &kp N2      &kp N3    &kp N4         &kp N5                            &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                 &kp NUMBER_6  &kp N7            &kp N8  &kp N9     &kp N0   &kp BACKSPACE
&kp TAB       &kp Q   &kp W       &kp E     &kp R          &kp T                             &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY               &kp Y         &kp U             &kp I   &kp O      &kp P    &kp MINUS
&kp LEFT_ALT  &kp A   &kp S       &kp D     &kp F          &kp G               &kp EQUAL     &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp LBKT   &kp H             &kp J   &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHFT     &kp Z   &kp X       &kp C     &kp V          &kp B               &kp GRAVE     &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RBKT   &kp N             &kp M   &kp COMMA  &kp DOT  &kp SINGLE_QUOTE  &lt 3 FSLH
&kp LCTRL             &kp C_MUTE  &kp LWIN  &kp RIGHT_ALT  &lt 1 LANG2         &kp SPACE                                                            &lt 1 SPACE  &lt 1 LANG1                                            &to MOUSE
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &kp F1   &kp F2     &kp F3    &kp F4     &kp F5                   &trans  &trans  &trans  &trans              &kp F6    &kp F7        &kp F8    &kp F9          &kp F10          &kp F11
&trans  &kp F6   &kp F7     &kp F8    &kp F9     &kp F10                  &trans  &trans  &trans  &trans              &kp F1    &kp F2        &kp F3    &kp F4          &kp F5           &kp F12
&trans  &kp F11  &kp HOME   &kp UP    &kp END    &kp HOME  &kp BACKSLASH   &trans  &trans  &trans  &trans    &kp LPAR  &kp C_VOL_UP    &kp HOME  &kp UP_ARROW    &kp END          &kp KP_MINUS  &trans
&trans  &none    &kp LEFT   &kp DOWN  &kp RIGHT  &kp END   &kp PIPE        &trans  &trans  &trans  &trans    &kp RPAR  &kp C_VOL_DN    &kp LEFT  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp KP_PLUS   &trans
&trans           &kp RSHFT  &trans    &trans     &trans    &trans                                         &trans    &trans                                                   &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp LA(F2) LA(F1)>;
            bindings = <
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none  &none
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none  &none
&trans  &none  &none  &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp PG_UP  &kp HOME  &none     &kp UP    &none      &none  &none
&trans  &none  &none  &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN  &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none
&trans  &none         &trans     &trans     &trans          &trans                                               &trans     &kp DEL                                         &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none         &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none         &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans                &kp C_MUTE    &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up_keep_mouse>;
            bindings = <
&to_layer_0 ESC  &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                  &to_layer_0 KP_N7     &to_layer_0 KP_N8  &to_layer_0 KP_N9   &to_layer_0 KP_DIVIDE                  &to_layer_0 NUMBER_6  &to_layer_0 N7     &to_layer_0 N8  &to_layer_0 N9  &to_layer_0 N0  &to_layer_0 BACKSPACE
&to_layer_0 TAB  &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                   &to_layer_0 KP_N4     &to_layer_0 KP_N5  &to_layer_0 KP_N6   &to_layer_0 KP_MULTIPLY                &to_layer_0 Y         &to_layer_0 U      &to_layer_0 I   &to_layer_0 O   &to_layer_0 P   &to_layer_0 MINUS
&trans           &to_layer_0 A   &to_layer_0 S   &to_layer_0 D   &to_layer_0 F   &scroll_up_keep_mouse    &scroll_left_keep_mouse   &to_layer_0 KP_N1     &to_layer_0 KP_N2  &to_layer_0 KP_N3   &to_layer_0 KP_MINUS       &to_layer_0 LBKT   &to_layer_0 H      &mkp LCLK       &mkp MCLK       &mkp RCLK       &to_layer_0 SEMI  &to_layer_0 ENTER
&trans           &to_layer_0 Z   &to_layer_0 X   &to_layer_0 C   &to_layer_0 V   &scroll_down_keep_mouse  &scroll_right_keep_mouse  &to_layer_0 KP_ENTER  &to_layer_0 KP_N0  &to_layer_0 KP_DOT  &to_layer_0 KP_PLUS        &to_layer_0 RBKT   &to_layer_0 N      &mkp MB4        &mkp MB5        &to_layer_0 DOT  &to_layer_0 SINGLE_QUOTE  &to_layer_0 FSLH
&trans                   &to_layer_0 C_MUTE  &to_layer_0 LWIN  &trans  &to_layer_0 LANG2  &to_layer_0 SPACE                                  &to_layer_0 SPACE  &to_layer_0 LANG1                                  &kp RCTRL
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
